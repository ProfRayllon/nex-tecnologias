# Copie para .env e preencha. O .env nunca vai para o Git.

# Domínio do site, sem https:// (o DNS precisa apontar para o IP da VPS).
DOMAIN=nextecnologias.com.br

# E-mail para o Let's Encrypt avisar sobre os certificados HTTPS.
ACME_EMAIL=contato@nextecnologias.com.br

# Senha do PostgreSQL da NEX (use algo longo e aleatório: openssl rand -base64 24).
POSTGRES_PASSWORD=troque-esta-senha

# Administrador criado no primeiro start (só quando o banco ainda não tem administrador).
# O sistema pede para trocar a senha no primeiro acesso.
ADMIN_EMAIL=contato@nextecnologias.com.br
ADMIN_PASSWORD=troque-esta-senha-tambem

# Duração da sessão de login, em horas.
SESSION_HOURS=12

# Tamanho máximo de cada arquivo enviado pelo painel (orçamento, telas, código), em MB.
MAX_UPLOAD_MB=500

# Desenvolvimento local (fora do Docker): npm run dev, dentro de server/.
# DATABASE_URL=
