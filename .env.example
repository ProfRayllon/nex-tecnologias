# Copie para .env e preencha em um editor local. Nunca versione o .env.
# Todos os endereços abaixo são fictícios; substitua-os antes de publicar.

# Domínio do site, sem https:// (DNS apontando para a VPS).
DOMAIN=example.com

# Contato do Let's Encrypt; não é autenticação SMTP.
ACME_EMAIL=certificados@example.com

# Obrigatória no Docker Compose. Gere uma senha exclusiva e mantenha-a no .env.
# Para uma instalação nova, prefira caracteres seguros para URL (ex.: openssl rand -hex 32).
# O Compose interpola esta senha na URL sem codificação automática.
POSTGRES_PASSWORD=

# Credenciais do primeiro administrador do portal, não da caixa de e-mail.
# ADMIN_PASSWORD é exigida somente ao criar o primeiro administrador no banco.
# Alterar esta variável não troca a senha de contas já existentes.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SESSION_HOURS=12
MAX_UPLOAD_MB=500

# Desenvolvimento fora do Docker (npm run dev dentro de server/):
# descomente e preencha a conexão local. O Compose monta a conexão de produção.
# DATABASE_URL=postgresql://nex:SENHA_CODIFICADA_PARA_URL@localhost:5432/nex

# O formulário de contato atual grava no banco. Não existe integração SMTP.
# Se uma integração for adicionada, injete as credenciais apenas no servidor.
